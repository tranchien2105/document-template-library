# Copy to .env.production and fill in the required values.
# Generate a strong password with: openssl rand -hex 32
DB_USERNAME=papertrail
DB_PASSWORD=
DB_DATABASE=papertrail

# The exact browser origin, with scheme and no trailing slash.
# Example: http://203.0.113.10 (use your VPS IP) or https://papertrail.example.com
CORS_ORIGIN=

# Backend Office template upload limit; default is 10 MiB (range: 1–50 MiB).
TEMPLATE_UPLOAD_MAX_BYTES=10485760
