
papertrail-dev.duckdns.org {
    encode zstd gzip

    @caddy_health path /_caddy-health
    respond @caddy_health "ok" 200

    @api path /api /api/*
    handle @api {
        # Limit uploads to 12 MB including multipart overhead.
        request_body {
            max_size 12MB
        }
        reverse_proxy backend:3001
    }

    handle /health {
        reverse_proxy backend:3001
    }

    handle {
        reverse_proxy frontend:3000
    }
}

# Internal healthcheck only, not exposed publicly.
:8080 {
    respond /_caddy-health "ok" 200
}
